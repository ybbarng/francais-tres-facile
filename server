#!/bin/bash
set -e

cd "$(dirname "$0")"

echo "📥 Pulling latest changes..."
git pull

echo "📦 Installing dependencies..."
pnpm install

echo "🔧 Generating Prisma client..."
pnpm run prisma:generate

echo "🗄  Applying SQL migrations (idempotent)..."
for sql in prisma/progress/migrations/*.sql; do
  [ -f "$sql" ] && sqlite3 data/progress.db < "$sql"
done

echo "🔨 Building..."
pnpm run build

echo "🔄 Restarting pm2..."
pm2 restart francais-tres-facile || pm2 start ecosystem.config.js

echo "✅ Deploy complete!"
