generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/progress"
}

datasource db {
  provider = "sqlite"
}

model Progress {
  id          String    @id @default(cuid())
  exerciseId  String    @unique
  completed   Boolean   @default(false)
  score       Int?
  maxScore    Int?
  listenCount Int       @default(0)
  notes       String?
  completedAt DateTime?
  hidden      Boolean   @default(false)
}

model ShadowingProgress {
  id            String    @id @default(cuid())
  materialId    String
  unit          String
  itemIndex     Int
  playCount     Int       @default(0)
  lastStudiedAt DateTime?

  @@unique([materialId, unit, itemIndex])
  @@index([materialId])
}
