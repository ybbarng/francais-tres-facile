          "id": "doc1",
          "context": "Vous êtes au marché. Une cliente parle avec un vendeur.",
          "audio": {
            "plays": 2,
            "script": [
              {
                "speaker": "Vendeur",
                "voice": "Thomas",
                "text": "Bonjour madame ! Qu'est-ce que vous voulez ?"
              },
              {
                "speaker": "Cliente",
                "voice": "Flo (프랑스어(프랑스))",
                "text": "Bonjour ! Je voudrais un kilo de tomates, s'il vous plaît."
              },
              {
                "speaker": "Vendeur",
                "voice": "Thomas",
                "text": "Voilà. Et avec ça ?"
              },
              {
                "speaker": "Cliente",
                "voice": "Flo (프랑스어(프랑스))",
                "text": "Vous avez des fraises ?"
              },
              {
                "speaker": "Vendeur",
                "voice": "Thomas",
                "text": "Non, désolé, pas aujourd'hui. J'ai des pommes et des oranges."
              },
              {
                "speaker": "Cliente",
                "voice": "Flo (프랑스어(프랑스))",
                "text": "Alors, deux kilos de pommes."
              },
              {
                "speaker": "Vendeur",
                "voice": "Thomas",
                "text": "Très bien. Ça fait 7 euros, s'il vous plaît."
              },
              {
                "speaker": "Cliente",
                "voice": "Flo (프랑스어(프랑스))",
                "text": "Voilà 10 euros."
              },
              {
                "speaker": "Vendeur",
                "voice": "Thomas",
                "text": "Et voilà 3 euros. Merci, bonne journée !"
              }
