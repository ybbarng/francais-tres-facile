              {
                "speaker": "Secrétaire",
                "voice": "Flo (프랑스어(프랑스))",
                "text": "Cabinet du docteur Moreau, bonjour."
              },
              {
                "speaker": "Patient",
                "voice": "Rocko (프랑스어(프랑스))",
                "text": "Bonjour madame. Je voudrais un rendez-vous avec le docteur, s'il vous plaît."
              },
              {
                "speaker": "Secrétaire",
                "voice": "Flo (프랑스어(프랑스))",
                "text": "Oui. Mardi à 10 heures, ça va ?"
